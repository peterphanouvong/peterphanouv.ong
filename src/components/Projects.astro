---
import site from "../data/site.json";
import projects from "../data/projects.json";
import { isVideo } from "../lib/media";
---

<section class="projects container" aria-labelledby="projects-heading">
  <h2 class="display" id="projects-heading">{site.headings.building}</h2>
  <div class="list">
    {
      projects.map((project) => (
        <article class="project">
          <a class="screenshot" href={project.url} aria-hidden="true" tabindex="-1">
            {
              isVideo(project.image) ? (
                <video
                  src={project.image}
                  poster={"poster" in project ? project.poster : undefined}
                  autoplay
                  muted
                  loop
                  playsinline
                  preload="metadata"
                />
              ) : (
                <img src={project.image} alt="" loading="lazy" />
              )
            }
          </a>
          <div class="details">
            <h3 class="display">
              <a href={project.url}>
                {project.title}&nbsp;<span class="arrow" aria-hidden="true">↗</span>
              </a>
            </h3>
            <p>{project.description}</p>
            <ul class="tags" aria-label="Tags">
              {project.tags.map((tag) => (
                <li>{tag}</li>
              ))}
            </ul>
          </div>
        </article>
      ))
    }
  </div>
</section>

<style>
  .projects {
    padding-block: clamp(2.5rem, 7vh, 4.5rem);
  }

  h2 {
    margin-bottom: 2.5rem;
  }

  .list {
    display: grid;
    gap: 4.5rem;
    /* Screenshots stay narrower than the headline, like the mockup */
    max-width: 42rem;
  }

  .screenshot {
    display: block;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid var(--line);
    box-shadow: 0 18px 40px -24px rgba(18, 18, 18, 0.4);
    transition: transform 0.35s ease, box-shadow 0.35s ease;
  }

  .screenshot:hover {
    transform: translateY(-4px);
    box-shadow: 0 26px 48px -24px rgba(18, 18, 18, 0.45);
  }

  .screenshot video {
    display: block;
    width: 100%;
    height: auto;
  }

  .details {
    margin-top: 1.35rem;
  }

  h3 {
    font-size: 1.375rem;
    margin-bottom: 0.5rem;
  }

  h3 a {
    text-decoration: none;
  }

  h3 a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .arrow {
    display: inline-block;
    font-family: var(--font-body);
    font-size: 1rem;
    color: var(--muted);
    transition: transform 0.2s ease, color 0.2s ease;
  }

  h3 a:hover .arrow {
    transform: translate(3px, -3px);
    color: var(--ink);
  }

  @media (prefers-reduced-motion: reduce) {
    .arrow {
      transition: none;
    }
  }

  .details p {
    max-width: 32rem;
    color: var(--soft);
  }

  .tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1rem;
  }

  .tags li {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--soft);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.2em 0.85em;
  }
</style>
