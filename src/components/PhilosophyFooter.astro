---
import site from "../data/site.json";
import projects from "../data/projects.json";
import { isVideo } from "../lib/media";

// Fixed scatter positions for the screenshot tiles. Each tile drifts along
// (dx, dy) and rotates by `r` degrees as the scroll progress (--p) goes 0 → 1.
const slots = [
  { left: "6%", top: "10%", width: "30%", dx: -1.1, dy: -0.7, r: -10 },
  { left: "56%", top: "5%", width: "34%", dx: 1.0, dy: -0.9, r: 8 },
  { left: "28%", top: "28%", width: "42%", dx: -0.2, dy: -1.3, r: -4 },
  { left: "1%", top: "52%", width: "32%", dx: -1.2, dy: 0.8, r: 6 },
  { left: "63%", top: "46%", width: "34%", dx: 1.2, dy: 0.6, r: -7 },
  { left: "18%", top: "72%", width: "30%", dx: -0.8, dy: 1.1, r: 9 },
  { left: "50%", top: "78%", width: "30%", dx: 0.5, dy: 1.2, r: -6 },
  { left: "38%", top: "-6%", width: "26%", dx: 0.3, dy: -1.2, r: 5 },
];

const tiles = slots.map((slot, i) => {
  const project = projects[i % projects.length];
  return {
    ...slot,
    image: project.image,
    poster: "poster" in project ? (project.poster as string) : undefined,
  };
});

const year = new Date().getFullYear();
---

<section class="runway" data-runway aria-label="Philosophy">
  <div class="stage">
    <img
      class="photo"
      src={site.philosophy.image}
      alt={site.philosophy.imageAlt}
      loading="lazy"
    />
    <div class="scrim"></div>
    <blockquote class="quote">
      <p class="display">{site.philosophy.quote}</p>
    </blockquote>
    {
      tiles.map((tile) => {
        const style = `left:${tile.left};top:${tile.top};width:${tile.width};--dx:${tile.dx};--dy:${tile.dy};--r:${tile.r}`;
        // Video projects show a still in the tiles (poster, or the video's
        // first frame) — eight looping videos would jank the scroll animation
        if (isVideo(tile.image) && !tile.poster) {
          return (
            <video
              class="tile"
              src={tile.image}
              muted
              playsinline
              preload="metadata"
              style={style}
            />
          );
        }
        return (
          <img
            class="tile"
            src={tile.poster ?? tile.image}
            alt=""
            loading="lazy"
            style={style}
          />
        );
      })
    }
  </div>
</section>

<footer class="site-footer">
  <div class="container row">
    <nav aria-label="Contact">
      {site.links.map((link) => <a href={link.url}>{link.label}</a>)}
    </nav>
    <p>© {year} {site.name}</p>
  </div>
</footer>

<noscript>
  <style>
    .runway .tile {
      display: none;
    }
    .runway .quote {
      opacity: 1;
    }
  </style>
</noscript>

<style>
  .runway {
    /* Tall track: the extra height is the scroll distance that drives --p */
    height: 200vh;
    --p: 0;
  }

  .stage {
    position: sticky;
    top: 0;
    height: 100vh;
    overflow: hidden;
    background: var(--ink);
  }

  .photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(calc(1.12 - var(--p) * 0.12));
  }

  .scrim {
    position: absolute;
    inset: 0;
    background: rgba(10, 10, 10, calc(0.15 + var(--p) * 0.25));
  }

  .quote {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 1.5rem;
    text-align: center;
    opacity: calc((var(--p) - 0.5) / 0.3);
    transform: translateY(calc((1 - var(--p)) * 40px));
  }

  .quote p {
    color: var(--paper);
    font-size: clamp(1.75rem, 3.5vw + 0.75rem, 3.25rem);
    max-width: 22ch;
    text-wrap: balance;
    text-shadow: 0 2px 24px rgba(0, 0, 0, 0.45);
  }

  .tile {
    position: absolute;
    border-radius: 10px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    box-shadow: 0 24px 60px -18px rgba(0, 0, 0, 0.6);
    transform: translate3d(
        calc(var(--dx) * var(--p) * 120vw),
        calc(var(--dy) * var(--p) * 120vh),
        0
      )
      rotate(calc(var(--r) * var(--p) * 1deg));
    will-change: transform;
  }

  .site-footer {
    background: var(--ink);
    color: var(--paper);
    padding-block: 1.5rem;
    font-size: 0.9375rem;
  }

  .row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .row nav {
    display: flex;
    gap: 1.25rem;
  }

  .row a {
    text-decoration: none;
    border-bottom: 1px solid rgba(242, 240, 233, 0.4);
  }

  .row a:hover {
    border-bottom-color: var(--paper);
  }

  .row p {
    color: rgba(242, 240, 233, 0.55);
  }

  @media (max-width: 640px) {
    /* Fewer, bigger tiles on small screens */
    .tile:nth-of-type(n + 6) {
      display: none;
    }
    .tile {
      min-width: 46%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .runway {
      height: auto;
    }
    .stage {
      position: relative;
    }
    .tile {
      display: none !important;
    }
    .photo {
      transform: none;
    }
    .quote {
      opacity: 1;
      transform: none;
    }
    .scrim {
      background: rgba(10, 10, 10, 0.4);
    }
  }
</style>

<script>
  const section = document.querySelector<HTMLElement>("[data-runway]");
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  if (section && !reduceMotion.matches) {
    let ticking = false;

    const update = () => {
      ticking = false;
      const rect = section.getBoundingClientRect();
      const track = rect.height - window.innerHeight;
      const p = Math.min(1, Math.max(0, -rect.top / track));
      section.style.setProperty("--p", p.toFixed(4));
    };

    const onScroll = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    };

    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll, { passive: true });
    update();
  }
</script>
